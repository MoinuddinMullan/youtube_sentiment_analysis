APP_NAME=Sentiview AI
ENVIRONMENT=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sentiview_db
MODEL_PATH=ml/artifacts/sentiment_model.joblib
VECTORIZER_PATH=ml/artifacts/tfidf_vectorizer.joblib
METADATA_PATH=ml/artifacts/model_metadata.json
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25
COMMENT_COLUMN=comment_text
SENTIMENT_COLUMN=label_sentiment
